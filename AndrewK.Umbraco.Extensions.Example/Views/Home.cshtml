@using Umbraco.Cms.Core.Serialization
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IJsonSerializer JsonSerializer
@{
    Layout = null;
}

<section>
    <h2>Dictionary:</h2>
    <p>
        <span>@(JsonSerializer.Serialize(Model.Value<ICollection<KeyValuePair<string, string>>>("dictionary")))</span>
    </p>
</section>
<section>
    <h2>Dropdown</h2>
    <p>
        <span>Single:</span>
        <span>@(JsonSerializer.Serialize(Model.Value<string>("dropdown")))</span>
    </p>
    <p>
        <span>Multiple:</span>
        <span>@(JsonSerializer.Serialize(Model.Value<ICollection<string>>("dropdownMultiple")))</span>
    </p>
</section>
<section>
    <h2>Checkbox</h2>
    <p>@(JsonSerializer.Serialize(Model.Value<ICollection<string>>("checkboxlist")))</p>
</section>
<section>
    <h2>Radiobutton</h2>
    <p>@(JsonSerializer.Serialize(Model.Value<string>("radiobuttonlist")))</p>
</section>
